# OpenAI provider 统一配置
LLM_BOOTSTRAP_PROVIDER=openai

# OpenAI 子协议：responses 或 chat
LLM_BOOTSTRAP_PROTOCOL=responses

# 复制为 .env 后，在等号后填写真实 API key
LLM_BOOTSTRAP_API_KEY=
LLM_BOOTSTRAP_MODEL=gpt-5.6
LLM_BOOTSTRAP_BASE_URL=https://api.openai.com/v1

# 图片输入不由环境变量全局开启。
# 业务创建 EnginePool 时须显式注入 ImageInputPolicy(enabled=True, ...)。
