# 二选一：OpenAI 官方协议（当前启用）
LLM_BOOTSTRAP_PROVIDER=openai
LLM_BOOTSTRAP_PROTOCOL=responses
LLM_BOOTSTRAP_API_KEY=
LLM_BOOTSTRAP_MODEL=gpt-5.6
LLM_BOOTSTRAP_BASE_URL=https://your-openai-endpoint.example/v1

# 二选一：Codex 代理独立 provider（使用时取消下列五行注释，并注释上面五行）
# LLM_BOOTSTRAP_PROVIDER=codex
# LLM_BOOTSTRAP_PROTOCOL=responses
# LLM_BOOTSTRAP_API_KEY=
# LLM_BOOTSTRAP_MODEL=gpt-5.6-luna
# LLM_BOOTSTRAP_BASE_URL=https://your-codex-proxy.example/v1

# 图片输入不由环境变量全局开启。
# 业务创建 EnginePool 时须显式注入 ImageInputPolicy(enabled=True, ...)。
